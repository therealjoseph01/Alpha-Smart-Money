# ---- mode -------------------------------------------------------------------
# backtest | paper | shadow | live
MODE=paper
# dev | prod. Only affects logging defaults; it does not relax any safety check.
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ---- infrastructure ---------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/asm.db
REDIS_URL=redis://localhost:6379/0

# ---- Helius (detection, RPC, fees, submission) ------------------------------
# https://dashboard.helius.dev  - free tier is enough to start
HELIUS_API_KEY=
# Optional explicit overrides; derived from the API key when blank
HELIUS_RPC_URL=
HELIUS_WS_URL=
RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# ---- Jupiter (routing, quotes, prices) --------------------------------------
# No key needed, and nothing to pay. Jupiter charges no platform fee - we never set
# platformFeeBps - so a swap costs only the pool fee, price impact and network fee,
# which you would pay on any DEX.
#
# The free lite-api allows roughly 60 requests a minute. At three open positions this
# system uses about 42, so a key is unnecessary. Leave both of these alone unless you
# run many more positions, in which case api.jup.ag with a key raises the limit.
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# ---- GMGN Agent API (candidate discovery) ------------------------------------
# Free key from https://gmgn.ai/ai. Used to FIND wallets worth evaluating - never to
# decide which to copy, and never for execution. Without a key discovery simply
# pauses; everything else keeps running.
GMGN_ENABLED=false

# ---- capital ----------------------------------------------------------------

# ---- live only (leave blank until a backtest says VIABLE) --------------------
# Two separate wallets, on purpose. The trading wallet holds only what you are
# willing to lose; harvested profit moves to the treasury, which the trading system
# has no key for and therefore cannot spend.
TRADING_WALLET_PUBKEY=
TREASURY_WALLET_PUBKEY=

# The signer daemon's own ceiling per transaction, enforced inside the signer so a
# bug in the trading code cannot raise it. 2 SOL.
SIGNER_MAX_LAMPORTS=2000000000
SIGNER_SOCKET=/tmp/asm-signer.sock
# NEVER commit a real key. Dev only; production uses the isolated signer process.
# SOLANA_KEYPAIR=

# Required for any mutating endpoint. The API refuses to authenticate while this is
# left at the placeholder value, so generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=dev-token-change-me

# ---- alerts (PRD 43) - optional; unset channels are simply unused --------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=warning

# ---- AI layer (PRD 40) - advisory only, never in the decision path -------------
ANTHROPIC_API_KEY=

# ---- MEV protection (PRD 27) --------------------------------------------------
MEV_PROTECTION_ENABLED=true
MEV_TIP_BPS=15
MAX_TIP_LAMPORTS=10000000

# ---- GMGN Agent API (discovery only — never execution) ------------------------
# Get a key at https://gmgn.ai/ai by uploading your public key.
GMGN_API_KEY=
GMGN_ENABLED=true
GMGN_PLAN_WEIGHT=5              # Free=5, Plus=20, Pro=50

# How many copyable wallets to hold. Discovery keeps refilling this.

# ---- where did the risk and gate settings go? --------------------------------
# Into the database. Code holds the initial defaults; the Settings tab in the
# dashboard changes them and saves the change, with bounds checking and an audit
# entry. A limit you can mistype into a file is a limit you can mistype.

# ---- deploying to a server ---------------------------------------------------
# Same file, four changes:
#   ENV=prod
#   LOG_JSON=true                      structured logs for whatever collects them
#   API_TOKEN=<32+ random characters>  the dashboard password is now internet-facing
#   DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/data/asm.db   (four slashes)
#
# The relative ./data path depends on the working directory, which systemd does not
# guarantee. Use an absolute path there.
#
# Do NOT expose the dashboard port publicly. Use an SSH tunnel:
#   ssh -L 8099:localhost:8099 you@server
