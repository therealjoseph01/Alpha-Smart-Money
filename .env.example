# ---- mode -------------------------------------------------------------------
# backtest | paper | shadow | live
MODE=paper
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ---- infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://asm:asm@localhost:5432/asm
REDIS_URL=redis://localhost:6379/0

# ---- Helius (detection, RPC, fees, submission) ------------------------------
# https://dashboard.helius.dev  - free tier is enough to start
HELIUS_API_KEY=
# Optional explicit overrides; derived from the API key when blank
HELIUS_RPC_URL=
HELIUS_WS_URL=
RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# ---- Jupiter (routing, quotes, prices) --------------------------------------
# lite-api needs no key. Use https://api.jup.ag with a key for higher limits.
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# ---- GMGN (optional auto-discovery) -----------------------------------------
# Leave false. Seed wallets manually from GMGN's UI into seeds/wallets.txt;
# the system scores and manages them itself from on-chain data after that.
GMGN_ENABLED=false
SEED_FILE=seeds/wallets.txt

# ---- capital ----------------------------------------------------------------
STARTING_CAPITAL_USD=1000

# ---- risk (PRD 22-25) -------------------------------------------------------
RISK_PRESET=balanced
RISK_BASE_POSITION_PCT=0.75
RISK_MAX_POSITION_PCT=2.0
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_DRAWDOWN_PCT=20.0
RISK_MAX_PORTFOLIO_DEPLOYED_PCT=60.0
RISK_STOP_LOSS_PCT=-25.0
RISK_TRAILING_STOP_PCT=20.0
RISK_HARVEST_THRESHOLD_PCT=25.0
RISK_HARVEST_TAKE_PCT=40.0

# ---- copyability gates (PRD 17) ---------------------------------------------
COPY_MIN_LIQUIDITY_USD=25000
COPY_MAX_EXPECTED_SLIPPAGE_PCT=3.0
COPY_MIN_TOKEN_AGE_SECONDS=300
COPY_MAX_OPEN_POSITIONS=20
COPY_MIN_TRADER_SCORE=60

# ---- live only (leave blank until phase E) ----------------------------------
TRADING_WALLET_PUBKEY=
TREASURY_WALLET_PUBKEY=
# NEVER commit a real key. Dev only; production uses the isolated signer process.
# SOLANA_KEYPAIR=

# Required for any mutating endpoint. The API refuses to authenticate while this is
# left at the placeholder value, so generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=dev-token-change-me

# ---- alerts (PRD 43) - optional; unset channels are simply unused --------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=warning

# ---- AI layer (PRD 40) - advisory only, never in the decision path -------------
ANTHROPIC_API_KEY=

# ---- MEV protection (PRD 27) --------------------------------------------------
MEV_PROTECTION_ENABLED=true
MEV_TIP_BPS=15
MAX_TIP_LAMPORTS=10000000

# ---- GMGN Agent API (discovery only — never execution) ------------------------
# Get a key at https://gmgn.ai/ai by uploading your public key.
GMGN_API_KEY=
GMGN_ENABLED=true
GMGN_PLAN_WEIGHT=5              # Free=5, Plus=20, Pro=50

# How many copyable wallets to hold. Discovery keeps refilling this.
TARGET_ROSTER_SIZE=15
SCORING_BUDGET_BOOTSTRAP=25     # candidates/day while the roster is short
SCORING_BUDGET_STEADY=5         # candidates/day once it is full
