# Copy to .env and fill in the three values that have no sensible default.
#
# This file holds only what differs from the defaults in src/asm/config.py. A line
# that matches its default is not configuration - it is a second copy of a number
# that can now disagree with the first.
#
# Deliberately absent:
#   DATABASE_URL, REDIS_URL  the defaults already point at ./data/asm.db and
#                            localhost:6379. In Docker the compose file sets both.
#   MODE                     not read. A new database starts in paper and the mode
#                            is changed from the dashboard, where the promotion
#                            gates are enforced.
#   risk limits, copy gates  stored in the database, editable under Settings.

# Structured JSON logs. Default is human-readable - leave this out locally.
LOG_JSON=true

# Detection, RPC, fees and submission. Free tier at https://dashboard.helius.dev
# Without it no wallet history can be read, so nothing gets scored.
HELIUS_API_KEY=

# Candidate discovery only, never execution. Set false to keep the roster exactly
# as you seeded it. Default is true.
GMGN_ENABLED=true
GMGN_API_KEY=

# Dashboard password - the only thing between the internet and a control that can
# switch to live trading. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---- live only --------------------------------------------------------------
# Your own two wallets. PUBLIC addresses, never private keys.
# Leave blank until you go live. The shadow -> live gate refuses to promote while
# either is empty, malformed, or the same address twice.
#
# Treasury must be a SEPARATE wallet whose private key this system does not hold,
# so harvested profit cannot be spent by the bot even if something goes wrong.
TRADING_WALLET_PUBKEY=
TREASURY_WALLET_PUBKEY=

# The PRIVATE key never goes here on a server. Development only; production runs
# asm-signer as its own process, key from KMS, reached over a unix socket.
# SOLANA_KEYPAIR=
